#include <windows.h>
#pragma code_page(65001)

101 ICON "Assets/TopPin.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "TopPin"
            VALUE "FileDescription", "极简窗口置顶工具"
            VALUE "FileVersion", "0.4.0"
            VALUE "InternalName", "TopPin"
            VALUE "OriginalFilename", "TopPin.exe"
            VALUE "ProductName", "TopPin"
            VALUE "ProductVersion", "0.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
